{
 "model": "hush.glb",
 "units": "metres, creature faces +Z, y up; ~20 m tall, ~28 m wingspan",
 "fps": 24,
 "notes": [
  "all actions are plain bone rotation keys (no IK/constraints in the GLB). root bone carries root motion: loc(root) is an offset in metres (y absolute above ground), rotation of root = yaw.",
  "non-loop actions are baked at 24 fps; loop actions have N frames and wrap (duration = frames/24).",
  "Blender action names == GLB animation names."
 ],
 "glow": {
  "material": "hush_glow (emissive ember red #ff3b1f, pulse its emissiveIntensity), hush_fire (mouth furnace / flames), vertex colour COLOR_0 on glow faces: r = distance from the chest core / 32 (0..1), g = random phase 0..1, b = 1 marks glow; non-glow faces are 0,0,0.",
  "core_world": [
   0,
   10.5,
   2.6
  ],
  "shader_hint": "I = .32 + .75*w + .22*rum + flare*1.5; w = sq(.5+.5*sin(t*2.1 - r*32*.55 + g*.3)); rum = (.5+.5 sin(t*4.9+g*6.28))*(.5+.5 sin(t*1.4+1.3+g*3)); white-hot when flare>1"
 },
